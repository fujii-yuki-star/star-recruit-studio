{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuko-recruit/schemas/extension-pack.schema.json",
  "title": "ExtensionPackManifest",
  "description": "拡張パックの manifest.json の規範スキーマ（ADR-0060）。パックはデータだけ（プログラムを入れない）。詳細は 11_SCHEMA_REFERENCE.md §7.7。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packId", "name", "version", "publisher", "minAppVersion", "contents", "files", "licenses"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "packId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
      "maxLength": 40,
      "description": "パックの名前（英小文字・数字・単独の _）。中の id の頭に付く（`pack_<packId>__<localId>`）＝ `__` を含めない。"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "description": "パックの版（同じ packId の古い版は入れない）。" },
    "publisher": { "type": "string", "minLength": 1, "maxLength": 60 },
    "description": { "type": "string", "maxLength": 400 },
    "minAppVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "description": "このパックを使えるアプリの最小の版。" },
    "contents": {
      "type": "object",
      "additionalProperties": false,
      "description": "中身の種類ごとの一覧（段階1＝見た目パターンと組み込み機能の鍵）。少なくとも1つは中身を持つ。",
      "minProperties": 1,
      "properties": {
        "templates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file"],
            "properties": {
              "file": { "$ref": "#/$defs/PackPath", "description": "template.schema.json に従う見た目パターンの JSON。templateId はパックの中の名前（取り込むときに頭へ `pack_<packId>__` が付く）。" }
            }
          }
        },
        "templateAssets": {
          "type": "array",
          "minItems": 1,
          "description": "見た目パターンの既定素材（写真・ロゴ）。見た目パターンの層の assetId からこの assetId で指す。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assetId", "file"],
            "properties": {
              "assetId": { "type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 40 },
              "file": { "$ref": "#/$defs/PackPath" }
            }
          }
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "有効にする組み込み機能の名前（アプリに組み込み済みのもの＝鍵は秘密ではない・ADR-0060 決定1）。",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 40 }
        }
      }
    },
    "files": {
      "type": "array",
      "description": "manifest.json 以外の中の全ファイル（相対パスと SHA-256）。入れるときに全部照合する。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/PackPath" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "description": "中身ごとの権利。書かれていない中身は入れない（ADR-0060 決定6）。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "license"],
        "properties": {
          "target": { "enum": ["templates", "templateAssets", "features"] },
          "license": { "type": "string", "minLength": 1, "maxLength": 200 },
          "credit": { "type": "string", "maxLength": 200, "description": "About（このアプリについて）に出す表記。" }
        }
      }
    }
  },
  "$defs": {
    "PackPath": {
      "type": "string",
      "description": "パックの中の相対パス（/ 区切り・英数字と - _ . だけ・.. や先頭の / を使わない）。",
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9_-][A-Za-z0-9_./-]*$",
      "maxLength": 200
    }
  }
}
