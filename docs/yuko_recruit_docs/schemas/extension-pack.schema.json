{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuko-recruit/schemas/extension-pack.schema.json",
  "title": "ExtensionPackManifest",
  "description": "拡張パックの manifest.json の規範スキーマ（ADR-0060）。パックはデータだけ（プログラムを入れない）。詳細は 11_SCHEMA_REFERENCE.md §7.7。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packId",
    "name",
    "version",
    "publisher",
    "minAppVersion",
    "contents",
    "files",
    "licenses"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "packId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
      "maxLength": 40,
      "description": "パックの名前（英小文字・数字・単独の _）。中の id の頭に付く（`pack_<packId>__<localId>`）＝ `__` を含めない。"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "パックの版（同じ packId の古い版は入れない）。"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "maxLength": 400
    },
    "minAppVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "このパックを使えるアプリの最小の版。"
    },
    "contents": {
      "type": "object",
      "additionalProperties": false,
      "description": "中身の種類ごとの一覧（段階1＝見た目パターンと組み込み機能の鍵・段階2＝文字の形と音楽・段階3＝声）。少なくとも1つは中身を持つ。",
      "minProperties": 1,
      "properties": {
        "templates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file"
            ],
            "properties": {
              "file": {
                "$ref": "#/$defs/PackPath",
                "description": "template.schema.json に従う見た目パターンの JSON。templateId はパックの中の名前（取り込むときに頭へ `pack_<packId>__` が付く）。"
              }
            }
          }
        },
        "templateAssets": {
          "type": "array",
          "minItems": 1,
          "description": "見た目パターンの既定素材（写真・ロゴ）。見た目パターンの層の assetId からこの assetId で指す。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "assetId",
              "file"
            ],
            "properties": {
              "assetId": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$",
                "maxLength": 40
              },
              "file": {
                "$ref": "#/$defs/PackPath"
              }
            }
          }
        },
        "fonts": {
          "type": "array",
          "minItems": 1,
          "description": "文字の形（フォント）。動画では `pack_<packId>__<fontId>` で指す（ADR-0060 決定4）。プロジェクトにはコピーしない（ADR-0038 と同じ＝アプリを再配布経路にしない）。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fontId",
              "file",
              "displayName"
            ],
            "properties": {
              "fontId": {
                "type": "string",
                "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$",
                "maxLength": 40,
                "description": "パックの中の名前（英小文字・数字・単独の _）。"
              },
              "file": {
                "allOf": [
                  {
                    "$ref": "#/$defs/PackPath"
                  },
                  {
                    "pattern": "\\.(ttf|otf|woff|woff2)$"
                  }
                ],
                "description": "ttf / otf / woff / woff2（小文字の拡張子）。"
              },
              "displayName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "description": "文字の形を選ぶ一覧に出す名前。"
              }
            }
          }
        },
        "bgm": {
          "type": "array",
          "minItems": 1,
          "description": "音楽（BGM）。素材の棚に並び、使うときに動画へコピーする（パックを外しても鳴る・ADR-0060 決定5）。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bgmId",
              "file",
              "displayName"
            ],
            "properties": {
              "bgmId": {
                "type": "string",
                "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$",
                "maxLength": 40,
                "description": "パックの中の名前（英小文字・数字・単独の _）。"
              },
              "file": {
                "allOf": [
                  {
                    "$ref": "#/$defs/PackPath"
                  },
                  {
                    "pattern": "\\.(mp3|m4a|wav|aac|ogg|flac)$"
                  }
                ],
                "description": "mp3 / m4a / wav / aac / ogg / flac（小文字の拡張子・取り込みで受ける音と同じ）。"
              },
              "displayName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "description": "素材の棚に出す名前。"
              }
            }
          }
        },
        "voices": {
          "type": "array",
          "minItems": 1,
          "description": "声（VOICEVOX の声のファイル `.vvm`）。入れると同梱の声と並べて声を作るソフトに読ませる（ADR-0060 決定7 追補）。キャラ名はクレジット（`VOICEVOX:<character>`）に出す。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "voiceId",
              "file",
              "character",
              "styles"
            ],
            "properties": {
              "voiceId": {
                "type": "string",
                "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$",
                "maxLength": 40,
                "description": "パックの中の名前（英小文字・数字・単独の _）。"
              },
              "file": {
                "allOf": [
                  {
                    "$ref": "#/$defs/PackPath"
                  },
                  {
                    "pattern": "\\.vvm$"
                  }
                ],
                "description": "VOICEVOX の声のファイル（.vvm）。"
              },
              "character": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "キャラ名（声を選ぶ一覧とクレジット「VOICEVOX:<character>」に出す）。"
              },
              "styles": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "speaker",
                    "label"
                  ],
                  "properties": {
                    "speaker": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100000,
                      "description": "声のファイルの中のスタイル番号（同梱の声・ほかのパックと重ねない）。"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20,
                      "description": "スタイル名（ノーマル・あまあま など）。"
                    }
                  }
                }
              }
            }
          }
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "有効にする組み込み機能の名前（アプリに組み込み済みのもの＝鍵は秘密ではない・ADR-0060 決定1）。",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 40
          }
        }
      }
    },
    "files": {
      "type": "array",
      "description": "manifest.json 以外の中の全ファイル（相対パスと SHA-256）。入れるときに全部照合する。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/PackPath"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "description": "中身ごとの権利。書かれていない中身は入れない（ADR-0060 決定6）。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "license"
        ],
        "properties": {
          "target": {
            "enum": [
              "templates",
              "templateAssets",
              "fonts",
              "bgm",
              "voices",
              "features"
            ]
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "credit": {
            "type": "string",
            "maxLength": 200,
            "description": "About（このアプリについて）に出す表記。"
          }
        }
      }
    }
  },
  "$defs": {
    "PackPath": {
      "type": "string",
      "description": "パックの中の相対パス（/ 区切り・各部分は英数字と - _ . だけ・. と .. の部分・空の部分・先頭や末尾の / を使わない・manifest.json は不可）。Rust の is_safe_rel_path と同じ規則。",
      "pattern": "^(?!manifest\\.json$)(?!(.*/)?\\.{1,2}(/|$))[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$",
      "maxLength": 200
    }
  }
}
