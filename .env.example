# -----------------------------------------------
# star-recruit-studio — 環境変数の例
# -----------------------------------------------
# 実値は絶対にコミットしない（.env は gitignore 済み）。本ファイルは例のみ。
#
# 方針: APIキーは原則 OSキーチェーンに保管する（docs/yuko_recruit_docs/13_DEPENDENCIES_AND_LICENSING.md §7）。
#       .env はローカル開発時の暫定用途。AIへ送るのは認証ヘッダのみで、本文・ログには載せない。

# 外部AIプロバイダ（使用するものだけ設定）
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key

# 任意（ローカルデバッグ）
# RUST_LOG=info
